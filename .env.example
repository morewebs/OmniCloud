# OmniCloud environment - copy to .env (or export) and fill in.
# Fernet key encrypting provider API tokens. Generate once:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up WITH the database - one is useless without the other.
OMNICLOUD_MASTER_KEY=
# SQLite path (WAL mode). Use a persistent volume in containers.
OMNICLOUD_DB=./omnicloud.db
# Session lifetime in days.
OMNICLOUD_SESSION_TTL_DAYS=30
# Default fleet sync interval in minutes (per-account override in Settings).
OMNICLOUD_SYNC_INTERVAL_MIN=5
# Secure session cookie. Keep 1 behind HTTPS; 0 only for local HTTP dev.
OMNICLOUD_COOKIE_SECURE=1
# Repo the panel checks for updates (owner/name). Defaults to the upstream.
OMNICLOUD_UPDATE_REPO=morewebs/OmniCloud
# 1 when behind a reverse proxy: rate-limit by X-Forwarded-For instead of the
# proxy IP (all clients share it otherwise). 0 otherwise (spoofable header).
OMNICLOUD_TRUST_PROXY=0
